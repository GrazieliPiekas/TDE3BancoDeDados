<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TDE3BancoDeDados.View.ProdutoPage"
             Title="Cadastro de Produtos">
    <ScrollView>
        <VerticalStackLayout Padding="10,0,0,0" Spacing="10">
            <Label Text="Código do Produto:"/>
            <HorizontalStackLayout Spacing="20">
                <Entry x:Name="txCodigo" Placeholder="Digite o código" Keyboard="Numeric"/>
                <Button x:Name="btConsultar" Text="Consultar" Clicked="btConsultar_Clicked"/>
                <Button x:Name="btLimpar" Text="Limpar Form" Clicked="btLimpar_Clicked"/>
            </HorizontalStackLayout>
            <Label Text="Para incluir não é preciso informar o código, ele é gerado automaticamente (AutoIncrement). Use o código apenas para consultar."
                   FontSize="12" TextColor="Gray"/>
            <Label Text="Nome do Produto:"/>
            <Entry x:Name="txNome" Placeholder="Digite o nome do produto" MaxLength="50"/>
            <Label Text="Tipo:"/>
            <Entry x:Name="txTipo" Placeholder="Digite o tipo do produto" MaxLength="50"/>
            <Label Text="Preço:"/>
            <Entry x:Name="txPreco" Placeholder="Digite o preço" Keyboard="Numeric"/>
            <Label Text="Quantidade em Estoque:"/>
            <Entry x:Name="txEstoque" Placeholder="Digite a quantidade em estoque" Keyboard="Numeric"/>

            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                <Button x:Name="btIncluir" Text="Incluir" Clicked="btIncluir_Clicked"/>
                <Button x:Name="btAlterar" Text="Alterar" Clicked="btAlterar_Clicked"/>
                <Button x:Name="btExcluir" Text="Excluir" Clicked="btExcluir_Clicked"/>
            </HorizontalStackLayout>

            <RefreshView x:Name="rvListaProdutos" Refreshing="rvListaProdutos_Refreshing">

                <CollectionView x:Name="lvListaProdutos"
                                HorizontalOptions="Start"
                                SelectionMode="Single"
                                SelectionChanged="lvListaProdutos_SelectionChanged">
                    <CollectionView.Header>
                        <Grid ColumnDefinitions="40,130,90,80,60" HorizontalOptions="Start"
                              BackgroundColor="DarkGray">
                            <Label Grid.Column="0" Text="COD" FontAttributes="Bold" FontSize="17"/>
                            <Label Grid.Column="1" Text="NOME" FontAttributes="Bold" FontSize="17"/>
                            <Label Grid.Column="2" Text="TIPO" FontAttributes="Bold" FontSize="17"/>
                            <Label Grid.Column="3" Text="PREÇO" FontAttributes="Bold" FontSize="17"/>
                            <Label Grid.Column="4" Text="QTD" FontAttributes="Bold" FontSize="17"/>
                        </Grid>
                    </CollectionView.Header>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="40,130,90,80,60"
                                  HorizontalOptions="Start" Padding="5">
                                <Label Grid.Column="0" Text="{Binding CodigoProduto}"/>
                                <Label Grid.Column="1" Text="{Binding NomeProduto}"/>
                                <Label Grid.Column="2" Text="{Binding Tipo}"/>
                                <Label Grid.Column="3" Text="{Binding Preco, StringFormat='{0:F2}'}"/>
                                <Label Grid.Column="4" Text="{Binding QtdEstoque}"/>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                </CollectionView>

            </RefreshView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
